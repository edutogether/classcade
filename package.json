{
  "name": "classcade",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run && tsc -b --noEmit",
    "preview": "vite preview",
    "entry:tune:apply": "node scripts/apply-entry-tuning.mjs",
