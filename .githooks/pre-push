#!/bin/sh
#
# Shared, version-controlled pre-push hook: guards freeze tags from deletion or
# force-move.
#
# Activate once per clone with:
#     git config core.hooksPath .githooks
#
# Rules, applied to refs/tags/*-freeze-*:
#   - creating a NEW freeze tag is allowed (the remote has no such ref yet)
#   - deleting an existing freeze tag is blocked
#   - moving an existing freeze tag to another commit is blocked
#
# Matching by name rather than a hard-coded SHA means a newly cut freeze tag is
# protected the moment it exists, with no hook edit required.

ZERO="0000000000000000000000000000000000000000"

while read -r local_ref local_sha remote_ref remote_sha; do
	case "$remote_ref" in
	refs/tags/*-freeze-*)
		if [ "$local_sha" = "$ZERO" ]; then
			echo "pre-push: BLOCKED — refusing to DELETE a freeze tag ($remote_ref)." >&2
			echo "          Freeze tags are official recovery points." >&2
			exit 1
		fi
		if [ "$remote_sha" != "$ZERO" ] && [ "$local_sha" != "$remote_sha" ]; then
			echo "pre-push: BLOCKED — refusing to MOVE a freeze tag ($remote_ref)." >&2
			echo "          Remote has $remote_sha but this push would set it to $local_sha." >&2
			echo "          Cut a new dated freeze tag instead of moving an existing one." >&2
			exit 1
		fi
		;;
	esac
done

exit 0
